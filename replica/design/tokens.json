{
  "_about": "Draftly design tokens. Roles, not colours: /replica-brand changes values and keeps the names. color.light and color.dark hold the same roles. Source of truth: `pnpm tokens` generates styles/tokens.css and lib/tokens.generated.ts from this file. Check every change with: python3 contrast.py replica/design/tokens.json",
  "_roles": {
    "bg": "app canvas behind the page",
    "surface": "the page, panels, the chat column",
    "raised": "cards, popovers, inputs, menus",
    "sunken": "hover fill, table headers, quiet chips",
    "pressed": "active fill, current item",
    "border": "dividers and card edges",
    "border-soft": "hairlines on the page",
    "border-input": "edges that must be seen: inputs, secondary buttons (3:1)",
    "text": "body and headings",
    "text-muted": "secondary text",
    "text-subtle": "meta, placeholders, timestamps",
    "text-disabled": "disabled labels (exempt from contrast)",
    "accent": "the one brand colour: primary buttons, links, the AI",
    "accent-hover": "hover of accent fills",
    "accent-subtle": "accent tint: AI messages, AI-edited text, selected rows",
    "accent-text": "text on accent-subtle",
    "on-accent": "text on accent",
    "focus": "focus ring",
    "danger": "destructive actions and errors",
    "danger-subtle": "error background",
    "on-danger": "text on danger",
    "success": "done and saved",
    "success-subtle": "success background",
    "warning": "needs attention",
    "warning-subtle": "warning background",
    "highlight": "commented text and text highlight",
    "tint-*": "table cell fills",
    "person-*": "collaborator cursors and avatars",
    "on-person": "initials on a person colour"
  },
