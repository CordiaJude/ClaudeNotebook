# Signs the session cookie. Set a long random value anywhere but local development.
SESSION_SECRET=

# The AI. With a key set (AI_API_KEY, or ANTHROPIC_API_KEY), the hosted model is used; without one, a scripted demo
# stands in (labelled "Demo AI"). While accounts are still the demo kind, the public production site keeps the scripted
# demo even with a key, so a stranger cannot spend it. Set ALLOW_PUBLIC_DEMO_AI=1 to override that knowingly.
AI_API_KEY=
ALLOW_PUBLIC_DEMO_AI=
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=
# How many AI requests one person may start per day.
AI_DAILY_RUNS=60

# PDF export uses headless Chromium. On a server it uses the packaged one; locally point this at a Chrome or Chromium binary.
CHROMIUM_PATH=

# Demo AI pacing (only used when no AI_API_KEY is set).
DEMO_AI_WORD_MS=18
DEMO_AI_TOOL_MS=600

# Not used yet: the database and realtime host arrive with the rest of the backend step.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
